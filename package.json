{
  "name": "cityengine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/typecheck.js && vite build && node tools/link-assets.js dist",
    "preview": "vite preview",
    "typecheck": "node tools/typecheck.js",
    "test": "vitest run",
    "bake": "node --max-old-space-size=12288 --experimental-strip-types tools/bake.ts",
    "map:v3": "node --max-old-space-size=8192 --experimental-strip-types tools/map-v3.ts",
    "shots": "node --experimental-strip-types tools/shots.ts",
    "movie": "node --experimental-strip-types tools/route-movie.ts",
    "landmarks": "node --experimental-strip-types tools/landmarks.ts",
    "audit:builders": "vite-node tools/audit-builders.ts",
    "audit:junctions": "vite-node tools/junction-audit.ts --",
    "audit:bake": "vite-node tools/bake-audit.ts --",
    "audit:nonbuildings": "vite-node tools/nonbuildings.ts --",
    "osm:fetch": "node --experimental-strip-types tools/osm-fetch.ts",
    "osm:compare": "node --experimental-strip-types tools/osm-compare.ts",
    "signs": "sh tools/signgen/build.sh",
    "assets": "node ${ASSETMGR_DIR:-../assetmgr}/dist/cli.js restore",
    "assets:upload": "node --experimental-strip-types tools/assetmgr-import.ts && node ${ASSETMGR_DIR:-../assetmgr}/dist/cli.js upload",
    "city:upload": "node --experimental-strip-types tools/city-upload.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.26.0",
    "@babylonjs/loaders": "^9.26.0",
    "avatarkit": "file:../avatarkit",
    "carkit": "file:../assetkit/carkit",
    "@dandyhorse/gamekit": "file:../dandyhorse/libs/gamekit",
    "@types/earcut": "^3.0.0",
    "@types/pngjs": "^6.0.5",
    "earcut": "^3.2.3",
    "pngjs": "^7.0.0",
    "polybooljs": "^1.2.2",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/node": "^24",
    "pbf": "^5.1.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.8",
    "vite": "^7",
    "vitest": "^3.2"
  }
}
