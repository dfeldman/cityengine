{
  "schemaVersion": 1,
  "id": "streetrunner",
  "name": "Street Runner",
  "version": "0.1.0",
  "author": "Dandyhorse",
  "description": "Ride or run through real cities, street by street: central Paris with its monuments, boats on the Seine and the métro on its viaducts, and more. Steer at the junctions from your phone; the trainer feels the real hills.",
  "entry": "index.html",
  "screenshot": "screenshot.jpg",
  "minPlatformVersion": "1.0",
  "capabilities": {
    "seed": false,
    "input": true,
    "saveState": true,
    "ghosts": false
  },
  "achievements": {
    "first-turn": {
      "name": "Your own way",
      "description": "Took a turn you chose."
    },
    "ten-km": {
      "name": "Ten kilometres",
      "description": "Rode 10 km through a real city."
    },
    "every-street": {
      "name": "Knows the neighbourhood",
      "description": "Rode every street of one city."
    }
  },
  "variants": [
    {
      "id": "bike",
      "name": "Street Runner (Bike)",
      "deviceTypes": [
        "bike"
      ],
      "defaultDuration": 1800,
      "controls": {
        "bike": "grade"
      },
      "description": "Your power moves you; the trainer feels the grade of the street."
    },
    {
      "id": "run",
      "name": "Street Runner (Run)",
      "deviceTypes": [
        "treadmill"
      ],
      "defaultDuration": 1800,
      "controls": {
        "treadmill": "incline"
      },
      "description": "The belt is your pace; the incline follows the street. The game never touches the belt speed."
    }
  ],
  "options": {
    "city": {
      "label": "City",
      "enum": [
        "paris-centre",
        "paris-marais",
        "brooklyn-heights",
        "chicago-loop",
        "san-francisco"
      ],
      "default": "paris-centre",
      "labels": [
        "Central Paris",
        "Le Marais, Paris",
        "Brooklyn Heights, New York",
        "The Loop, Chicago",
        "San Francisco"
      ]
    },
    "traffic": {
      "label": "Other people",
      "enum": [
        "none",
        "some",
        "busy"
      ],
      "default": "some",
      "labels": [
        "Empty streets",
        "Some",
        "Busy"
      ]
    },
    "time": {
      "label": "Time of day",
      "enum": [
        "day",
        "dawn",
        "dusk",
        "night"
      ],
      "default": "day",
      "labels": [
        "Day",
        "Dawn",
        "Dusk",
        "Night"
      ]
    },
    "weather": {
      "label": "Weather",
      "enum": [
        "clear",
        "overcast",
        "rain"
      ],
      "default": "clear",
      "labels": [
        "Clear",
        "Overcast",
        "Rain"
      ]
    }
  }
}
