# ---- generated, never committed -------------------------------------------------
# The repo is kept under 100 MB. Everything below is rebuilt by a tool, and what to
# run is in docs/ASSETS.md. docs/shots and public/cities alone were 705 MB of the
# 772 MB that used to be tracked.
#
# NOTE: gitignore has no inline comments — a trailing "# ..." becomes part of the
# pattern and silently matches nothing. Keep every comment on its own line.

# every screenshot: model shots, contact sheets, references
docs/shots/
# baked city packages and their streamed tiles (npm run bake), and their map-format-v3
# conversions (npm run map:v3, written to public/cities/<id>/v3/). THE BAKE IS NEVER COMMITTED.
# What IS committed is what is applied on top of it: public/patches/ (MAP-FORMAT section 8) and
# the landmark manifests in public/landmarks/ - hand-made, small, and not reproducible by a tool.
public/cities/
# the bake's per-building audit trail (tools/bake.ts writes docs/<city>-archetypes.csv)
docs/*-archetypes.csv
# generated GLBs, signgen's included (npm run signs)
public/models/
# generated SF street trees (tools/sftrees/library.py)
public/sftrees/
public/plants/
public/trees/*.glb
scratchpad/
# OSM extracts, Overpass chunks, Mapillary tiles and photos
tools/cache/
# reference photographs gathered for hand modelling
statues_to_model/
# the automated render-review pages (tools/review-page.ts): Mapillary references, renders,
# the generated HTML and its reports. Regenerated on demand; nothing in it is hand-made.
docs/review/
# per-session scratch output from tools and one-off scripts
*.log
!docs/soak-*.log

# ---- secrets --------------------------------------------------------------------
.mapillary-token
.mapillary-app
.mapillary_token

__pycache__/
*.pyc

# tools/lidar python environment (uv venv --python 3.12 tools/lidar/.venv; see docs/LIDAR.md)
tools/lidar/.venv/
*.swp

# assetmgr: downloaded asset files and the per-checkout hash cache (indexes/ IS committed)
/assets/
.assetmgr/

# ---- assets in the shared bucket (index streetrunner), put back at these paths by `npx assetmgr restore` ------
# (generated by tools/facadegen, tools/palmgen and tools/roadgen; record changes with tools/assetmgr-import.ts)
public/facades/*.png
public/facades/walls/
public/palms/
public/roads/
public/rocks/textures/*.jpg
public/og.jpg
gondola-ride.png
platform/screenshot.jpg

# never symlinks into sibling repos: local-assets mode reads them through /@fs/ (src/assets.ts, vite.config.ts)
public/mh
public/env
public/trees
public/plants

# written by tools/typecheck.js (gamekit's location comes from DANDYHORSE_DIR)
.tsconfig.typecheck.json
.gamekit-absent.d.ts
