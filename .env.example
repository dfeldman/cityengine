# cityengine credentials: copy to .env (git-ignored) and fill in. Never commit .env.
# A Cloudflare ACCOUNT API token with R2 read & write: assetmgr (npm run assets:upload) and the deploy derive R2's
# S3 key pair from it (key id = the token's id, secret = its SHA-256)
CLOUDFLARE_API_TOKEN=
# the shared asset bucket (assetmgr)
CLOUDFLARE_BUCKET=assets
# the site's bucket and the account's R2 S3 endpoint (tools/r2-upload.sh, tools/r2-prune.sh)
DEPLOY_BUCKET=dash
DEPLOY_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# street-level imagery for tools/photo.ts (mapillary.com → Developers)
MAPILLARY_TOKEN=
